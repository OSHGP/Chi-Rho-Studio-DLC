{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chi-rho-studio.example/schemas/catalog-index.schema.json",
  "title": "Chi Rho Studio Catalog Subscription Index",
  "type": "object",
  "required": ["format_version", "name", "catalogs"],
  "properties": {
    "format_version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "updated": {"type": "string"},
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "path", "version", "updated"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 0},
          "updated": {"type": "string"},
          "file_size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
