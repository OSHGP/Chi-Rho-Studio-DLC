{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chi Rho Studio Application Language Catalog",
  "type": "object",
  "required": [
    "format_version",
    "catalog_name",
    "entries"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "catalog_name": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "locale",
          "name",
          "version",
          "translation_format_version",
          "path",
          "sha256",
          "file_size",
          "english_name"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "native_name": {
            "type": "string"
          },
          "english_name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "app_min_version": {
            "type": "string"
          },
          "translation_format_version": {
            "type": "integer",
            "const": 3
          },
          "translator": {
            "type": "string"
          },
          "completion": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "path": {
            "type": "string",
            "pattern": "^\\.\\./packages/languages/[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "file_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "updated": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    }
  }
}
